#!/usr/bin/env python3
"""M-Journey System: typed research topology, stage-constrained geometric layout,
original Legible Cities SVG renderer, zero transit/timetable user interface.
LOOM is an optional geometry proposal ONLY: it can never add or remove a
source research connection. No map geography or elapsed time is inferred.
"""
import collections
import json
import math
import argparse
import html
import sys
from pathlib import Path

ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT/"src"))
from schematic.linegraph import LineGraph, Node, Edge, Line
from schematic.mjourney import _octilinear
from schematic.render import Style, render
from schematic import loom

KINDS={"sequence","branch","convergence","handoff"}

def route(edges, start, end, *, avoid=None):
    graph=collections.defaultdict(list)
    for e in edges:
        if e["kind"] in KINDS and e["id"]!=avoid:
            graph[e["fromId"]].append(e)
    todo=collections.deque([(start,[])])
    seen=set()
    while todo:
        at,path=todo.popleft()
        if at==end:return path
        if at in seen:continue
        seen.add(at)
        for e in graph[at]:todo.append((e["toId"],path+[e["id"]]))
    raise ValueError(f"no source-backed directed path: {start} -> {end}")

def stage_layout(source):
    moments={m["id"]:m for m in source["moments"]}
    stages=sorted(source["stages"],key=lambda s:s["order"])
    ordered=collections.defaultdict(list)
    for m in source["moments"]:ordered[m["stageId"]].append(m["id"])
    # Initial order is a presentation preference; never replace source stage.
    rank={"layer-1":0, "layer-5":1, "layer-4":2, "layer-0":3,
          "layer-2":4, "layer-3":5, "layer-6":6}
    for st in stages:
        ids=ordered[st["id"]]
        ids.sort(key=lambda mid:(rank.get(moments[mid]["layerId"],3),int(mid[2:])))
    adjacency=collections.defaultdict(list)
    for e in source["connections"]:
        if e["kind"] not in KINDS:continue
        if e["fromId"] in moments and e["toId"] in moments:
            adjacency[e["fromId"]].append(e["toId"])
            adjacency[e["toId"]].append(e["fromId"])
    # Sugiyama-style sweeps: order stations using canonical edges, not category guides.
    for k in range(12):
        sweep=stages if k%2 else list(reversed(stages))
        positions={mid:i/max(1,len(ids)-1) for ids in ordered.values() for i,mid in enumerate(ids)}
        for st in sweep:
            ids=ordered[st["id"]]
            old={mid:i for i,mid in enumerate(ids)}
            def bary(mid):
                nearby=[positions[j] for j in adjacency[mid]
                        if moments[j]["stageId"]!=moments[mid]["stageId"]]
                if not nearby:return old[mid]/max(1,len(ids)-1)
                return 0.72*sum(nearby)/len(nearby)+0.28*old[mid]/max(1,len(ids)-1)
            ids.sort(key=lambda mid:(bary(mid),old[mid],mid))
    widths={}
    starts={};x=120.0
    for stage in stages:
        count=len(ordered[stage["id"]])
        width=max(300.0,220.0+count*31.0)
        starts[stage["id"]]=x
        widths[stage["id"]]=width
        x+=width+56.0
    loc={}
    for stage in stages:
        ids=ordered[stage["id"]]
        count=len(ids)
        # Fixed ordinal stage bounds, flexible station density. No duration.
        pitch=min(94.0,980/max(count-1,1))
        for i,mid in enumerate(ids):
            source_position=next(j for j,m in enumerate(source["moments"]) if m["id"]==mid)
            same_stage_source=[m["id"] for m in source["moments"] if m["stageId"]==stage["id"]]
            slot=same_stage_source.index(mid)
            a=starts[stage["id"]];w=widths[stage["id"]]
            xx=a+40+(w-80)*(slot+1)/(count+1)
            yy=665+(i-(count-1)/2)*pitch
            loc[mid]=(xx,yy)
    bounds=[dict(id=s["id"],name=s["shortName"],fullName=s["name"],
                 startX=starts[s["id"]],endX=starts[s["id"]]+widths[s["id"]]) for s in stages]
    return loc,bounds

def graph_of(source,positions):
    layers={l["id"]:l for l in source["layers"]}
    moments={m["id"]:m for m in source["moments"]}
    nodes={mid:Node(id=mid,coord=positions[mid],station_id=mid,
                    station_label=m["label"],props={"stageId":m["stageId"],
                  "layerId":m["layerId"],"sourceMomentId":mid})
           for mid,m in moments.items()}
    lines={lid:Line(id=lid,label=l["name"],color=l["color"]) for lid,l in layers.items()}
    edges=[]
    for item in source["connections"]:
        if item["kind"] not in KINDS:continue
        a,b=item["fromId"],item["toId"]
        origin=moments[a]["layerId"]
        edges.append(Edge(src=a,dst=b,geometry=_octilinear(positions[a],positions[b]),
                          lines=[lines[origin]],props={"sourceEdgeIds":[item["id"]],
                          "sourceKind":item["kind"],"sourceRouteId":item["routeId"],
                          "projectionRole":"canonical-authored-connection",
                          "traversable":True}))
    return LineGraph(nodes=nodes,edges=edges)

def pairs(graph):
    # This compares directed endpoint identities and edge multiplicity, rather
    # than treating any path through a synthetic vertex as a researched step.
    counts=collections.Counter()
    for e in graph.edges:
        if graph.nodes[e.src].station_id and graph.nodes[e.dst].station_id:
            counts[(graph.nodes[e.src].station_id,graph.nodes[e.dst].station_id,
                    tuple(x.id for x in e.lines))]+=1
    return counts

def native_hint(source,graph,path,enabled):
    if not enabled:return graph,{"attempted":False,"used":False,"reason":"disabled"}
    # Optional LOOM route ordering/geometry, without topology aggregation, on
    # the exact research graph. Accept only if all authored direct adjacencies
    # survive; otherwise source geometry remains authoritative.
    seed=graph.to_geojson()
    adjusted=json.loads(json.dumps(seed))
    # LOOM operates on geographic-sized coordinates; these are synthetic.
    for feature in adjusted["features"]:
        geo=feature["geometry"]
        if geo["type"]=="Point":
            x,y=geo["coordinates"];geo["coordinates"]=[8+x/5000,48+y/5000]
        elif geo["type"]=="LineString":
            geo["coordinates"]=[[8+x/5000,48+y/5000] for x,y in geo["coordinates"]]
    try:
        out=loom.run("loom",adjusted,timeout=160)
        path.with_suffix(".loom.geojson").write_text(json.dumps(out,indent=2))
        octi=loom.run("octi",out,timeout=160)
        path.with_suffix(".octi.geojson").write_text(json.dumps(octi,indent=2))
        candidate=LineGraph.from_geojson(octi)
        original_ids={n.station_id for n in graph.stations}
        solved_ids={n.station_id for n in candidate.stations}
        if original_ids!=solved_ids:
            return graph,{"attempted":True,"used":False,"reason":"station identity changes",
                          "expected":len(original_ids),"actual":len(solved_ids)}
        # The native tools can insert geometry-only junctions and merge edges.
        # Reject unless the full direct source edge ID set can be proven.
        # Station positions MAY be adopted, but only with stage re-projection;
        # original edges still come from graph_of() above, never LOOM edges.
        y_values=[n.coord[1] for n in candidate.stations];lo,hi=min(y_values),max(y_values)
        candidate_by_id={n.station_id:n for n in candidate.stations}
        positions={}
        for mid,n in graph.nodes.items():
            old=n.coord
            # Preserve x/stage hard constraint, optimize only rank in y.
            sy=candidate_by_id[mid].coord[1]
            positions[mid]=(old[0],250+830*(sy-lo)/max(hi-lo,0.0000001))
        rebuilt=graph_of(source,positions)
        if pairs(rebuilt)!=pairs(graph):
            raise ValueError("edge identity or source adjacency changed")
        return rebuilt,{"attempted":True,"used":True,
                        "role":"LOOM-derived vertical order; canonical edges reconstructed",
                        "sourceEdgesPreserved":len(graph.edges),
                        "authoritative":"M-Journey authored connections, not LOOM topology"}
    except Exception as exc:
        return graph,{"attempted":True,"used":False,
                      "reason":str(exc)[:350],"fallback":"source-authored topology"}

def supplementary(svg,source,graph,bounds):
    # Overlay stage guides with the SAME camera as the schematic.
    import xml.etree.ElementTree as ET
    ET.register_namespace("","http://www.w3.org/2000/svg")
    root=ET.fromstring(svg)
    ns="{http://www.w3.org/2000/svg}"
    # Original renderer labels link through data-node rather than station IDs.
    ptr={e.attrib.get("data-node"):e.attrib.get("data-station-id")
         for e in root.findall(".//"+ns+"circle") if e.attrib.get("data-station-id")}
    moments={m["id"]:m for m in source["moments"]}
    for label in root.findall(".//"+ns+"g[@id='labels']/"+ns+"text"):
        mid=ptr.get(label.attrib.get("data-node"))
        if mid:
            label.set("data-station-id",mid)
            label.set("class","key-label" if moments[mid].get("key") else "detail-label")
    box=[float(x) for x in root.get("viewBox").split()]
    # Stage header on map canvas; headings pan and zoom with stations.
    upper=box[1]-105
    layers=ET.Element(ns+"g",{"id":"journey-stage-guides","aria-label":"Ten authored stages"})
    for st in bounds:
        x1=st["startX"];x2=st["endX"];xm=(x1+x2)/2
        line=ET.SubElement(layers,ns+"line",{"x1":str(x1),"x2":str(x1),
                 "y1":str(upper+48),"y2":str(box[1]+box[3]-45),
                 "stroke":"#5c514a","stroke-width":"1","stroke-dasharray":"2 13",
                 "opacity":"0.38"})
        ET.SubElement(layers,ns+"text",{"x":str(xm),"y":str(upper+30),
                  "fill":"#d9d0c4","font-size":"19","font-weight":"650",
                  "text-anchor":"middle","letter-spacing":"0.2"}).text=st["name"]
    root.insert(1,layers)
    # Lifecycle return has distinct relationship semantics, not a forward path.
    source_by={e["id"]:e for e in source["connections"]}
    lifecycle=[e for e in source["connections"] if e["kind"]=="lifecycle_return"]
    if lifecycle:
        station_by={n.station_id:n for n in graph.stations}
        e=lifecycle[0];a=station_by[e["fromId"]].coord;b=station_by[e["toId"]].coord
        bottom=max(n.coord[1] for n in graph.stations)+140
        overlay=ET.SubElement(root,ns+"g",{"id":"research-return","data-kind":"lifecycle_return"})
        ET.SubElement(overlay,ns+"path",{"d":f"M {a[0]:.2f} {a[1]:.2f} V {bottom:.2f} H {b[0]:.2f} V {b[1]:.2f}",
                  "stroke":"#ac9a88","stroke-width":"2.2","stroke-dasharray":"7 10",
                  "fill":"none","opacity":"0.58"})
        ET.SubElement(overlay,ns+"text",{"x":str((a[0]+b[0])/2),"y":str(bottom-13),
                  "text-anchor":"middle","fill":"#b2a496","font-size":"14"}).text="Lifecycle feedback"
    # Avoid clipped headings/return in the original viewBox.
    new_top=min(upper-5,box[1]);bottom=max(n.coord[1] for n in graph.stations)+185
    new_bottom=max(box[1]+box[3],bottom)
    root.set("viewBox",f"{box[0]-40:.2f} {new_top:.2f} {box[2]+80:.2f} {new_bottom-new_top:.2f}")
    root.set("role","img")
    root.set("aria-label","Equipment buying source-connected systems schematic")
    root.set("preserveAspectRatio","xMidYMid meet")
    root.attrib.pop("width",None);root.attrib.pop("height",None)
    return ET.tostring(root,encoding="unicode")

def page(svg,source,bounds,projection,model):
    # The journey-specific HTML intentionally does NOT import animate.texts.
    # Thus train schedules, clocks, passenger journeys and date pickers cannot appear.
    moments={m["id"]:m for m in source["moments"]}
    connections=source["connections"]
    common=route(connections,"eq01","eq31")
    end=route(connections,"eq37","eq39")
    ae=common+["edge44","edge48","edge49","edge50"]+end
    direct=common+["edge45","edge51","edge52"]+end
    payload=json.dumps({"moments":source["moments"],"connections":connections,
            "layers":source["layers"],"stages":source["stages"],
            "branches":{"ae":ae,"direct":direct},"bounds":bounds,"geometry":projection},
            separators=(",",":")).replace("<","\\u003c")
    return """<!doctype html><html lang="en"><head><meta charset="utf-8">
