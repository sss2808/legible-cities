 legend.append(btn);
});
let drag=null;
function point(ev){let r=svg.getBoundingClientRect();return {x:vb.x+(ev.clientX-r.left)/r.width*vb.width,y:vb.y+(ev.clientY-r.top)/r.height*vb.height}}
svg.addEventListener('pointerdown',e=>{if(e.target.closest('#stations'))return;drag={px:e.clientX,py:e.clientY};svg.setPointerCapture(e.pointerId);svg.classList.add('dragging')});
svg.addEventListener('pointermove',e=>{if(!drag)return;vb.x-=(e.clientX-drag.px)/svg.clientWidth*vb.width;vb.y-=(e.clientY-drag.py)/svg.clientHeight*vb.height;drag.px=e.clientX;drag.py=e.clientY});
svg.addEventListener('pointerup',()=>{drag=null;svg.classList.remove('dragging')});
svg.addEventListener('wheel',e=>{e.preventDefault();let p=point(e);zoom(e.deltaY>0?1.17:.86,p.x,p.y)},{passive:false});
svg.addEventListener('dblclick',()=>fit());fit();
})();
</script></body></html>""".replace("__SVG__",svg).replace("__DATA__",payload)

def main():
    p=argparse.ArgumentParser()
    p.add_argument("--source",default="fixtures/mjourney/equipment-sanitized-v1.json")
    p.add_argument("--output",default="out/mjourney-system-v6")
    p.add_argument("--loom",action="store_true",help="Test native LOOM geometry proposal with strict source rehydration")
    args=p.parse_args()
    source=json.loads(Path(args.source).read_text())
    stages=sorted(source["stages"],key=lambda s:s["order"])
    assert len(stages)==10 and len(source["moments"])==67 and len(source["connections"])==87
    loc,bounds=stage_layout(source)
    graph=graph_of(source,loc)
    output=Path(args.output);output.parent.mkdir(parents=True,exist_ok=True)
    expected=[e for e in source["connections"] if e["kind"] in KINDS]
    assert len(expected)==83 and len(graph.edges)==83 and len(graph.stations)==67
    graph,proposal=native_hint(source,graph,output,args.loom)
    assert pairs(graph)==pairs(graph_of(source,loc)),"CRITICAL: source edge topology changed"
    style=Style(background="#221c17",station_fill="#fff5e5",station_stroke_color="#251b16",
        label_color="#f6ede2",line_width=7,line_gap=1.5,station_radius=4.5,
        interchange_radius=6,station_stroke=2,label_size=13,label_offset=12,padding=30)
    layers=sorted(source["layers"],key=lambda l:l["order"])
    palette={l["name"]:l["color"] for l in layers}
    result=render(graph,width=2850,style=style,
                  line_order=[l["name"] for l in layers],colors=palette)
    svg=supplementary(result.svg,source,graph,bounds)
    output.with_suffix(".svg").write_text(svg)
    output.with_suffix(".html").write_text(page(svg,source,bounds,proposal,"system"))
    audit={"view":"System", "timetableControls":False, "renderEngine":"original Legible Cities schematic.render",
           "canonical":{"moments":67,"connections":87,"renderedAuthoredEdges":83,
                "dependencies":3,"lifecycleReturns":1,"stages":10,"layers":7},
           "geometry":{"stageConstraints":"hard left-to-right ordinal windows","loom":proposal,
                       "sourceEdgePairPreserved":True, "noInferredInterchanges":True,
                       "stages":bounds},"render":{"droppedLabels":result.dropped_labels,
                       "svg":output.with_suffix(".svg").name,
                       "html":output.with_suffix(".html").name},
           "paths":{"aeEpc":route(source["connections"],"eq01","eq31")+["edge44","edge48","edge49","edge50"]+route(source["connections"],"eq37","eq39"),
                    "direct":route(source["connections"],"eq01","eq31")+["edge45","edge51","edge52"]+route(source["connections"],"eq37","eq39")}}
    output.with_suffix(".audit.json").write_text(json.dumps(audit,indent=2))
    print(json.dumps({"status":"rendered","stations":len(graph.stations),
         "renderedSourceEdges":len(graph.edges),"droppedLabels":len(result.dropped_labels),
         "loom":proposal},indent=2))
if __name__=="__main__":main()
