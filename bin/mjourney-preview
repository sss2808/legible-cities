#!/usr/bin/env python3
"""Generate an M-Journey schematic using Legible Cities' original SVG engine.

The first preview is a layer-organized *reading map*, not a validated customer
route map. It contains no timetable or fabricated transfers. It is intentionally
SVG-only until the browser's timetable/routing controls support no-service maps.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from schematic.mjourney import from_json  # noqa: E402
from schematic.render import render  # noqa: E402

DEFAULT_SOURCE = ROOT / "fixtures/mjourney/equipment-sanitized-v1.json"


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", type=Path, default=DEFAULT_SOURCE)
    parser.add_argument("--output", type=Path,
                        default=ROOT / "out/mjourney-equipment-schematic.svg")
    parser.add_argument("--full", action="store_true",
                        help="Include all 67 moments, not the curated 26-station study")
    parser.add_argument("--width", type=float, default=1650.0)
    args = parser.parse_args(argv)

    source = json.loads(args.source.read_text(encoding="utf-8"))
    selection = list(m["id"] for m in source["moments"]) if args.full else None
    projection = from_json(args.source, station_ids=selection)
    line_order = [layer["name"] for layer in projection.layers]
    result = render(projection.graph, width=args.width, line_order=line_order,
                    colors={layer["name"]: layer["color"]
                            for layer in projection.layers})
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(result.svg, encoding="utf-8")
    audit = args.output.with_suffix(".audit.json")
    report = dict(projection.audit)
    report["render"] = {
        "engine": "schematic.render.render (original Legible Cities)",
        "stations": len(projection.graph.stations),
        "tracks": len(result.tracks),
        "droppedLabels": result.dropped_labels,
        "svg": args.output.name,
        "timetable": None,
        "routingEnabled": False,
        "stageConstraintStatus": "coordinate seeds only; requires visual review",
    }
    audit.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
    print(f"SVG: {args.output}")
    print(f"Audit: {audit}")
    print(f"{len(projection.graph.stations)} stations; {len(result.tracks)} tracks; "
          f"{len(result.dropped_labels)} dropped labels")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
