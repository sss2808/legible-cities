#!/usr/bin/env python3
"""Build source-backed M-Journey diagrams with the *original* Legible Cities renderer.

--network selects the research-source-connected topology instead of the older
organizational guides. --html emits the original Legible Cities interactive
page (Schematic/Linear and line/label toggles) with irrelevant timetable and
passenger-trip affordances suppressed, not rewritten as a custom map.
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from schematic import animate  # noqa: E402
from schematic.mjourney import build_network_projection, build_system_v3, from_json  # noqa: E402
from schematic.mjourney_research_contract import build_system_contract  # noqa: E402
from schematic.render import Style, render  # noqa: E402

DEFAULT_SOURCE = ROOT / "fixtures/mjourney/equipment-sanitized-v1.json"


def viewer_for_journey(page: str, research_contract: dict | None = None) -> str:
    """Preserve native page and controls, remove transport-specific UI.

    The compiled page retains the original fork tracks, SVG and camera. A
    guarded M-Journey browser mode disables passenger-route behavior; a
    validated System contract adds the read-only research inspector. The
    upstream transit behavior remains unchanged without the M-Journey flag.
    """
    ident = '<meta charset="utf-8">'
    prepaint = (ident + '\n'
                '<script>document.documentElement.setAttribute("data-mjourney", "");'
                + ('document.documentElement.setAttribute("data-mjourney-inspector", "");'
                   if research_contract is not None else '')
                + '</script>')
    if ident not in page:
        raise ValueError("Legible Cities HTML has no known metadata seam")
    page = page.replace(ident, prepaint, 1)
    css = """
  /* M-Journey has no GTFS trains, clock, or service day. Source line controls
     and original Schematic/Linear viewer still work exactly as upstream. */
  :root[data-mjourney] #view-string,
  :root[data-mjourney] #view-geo,
  :root[data-mjourney] #view-linear,
  :root[data-mjourney] header .bar:nth-of-type(2),
  :root[data-mjourney] #more,
  :root[data-mjourney] #trip { display: none !important; }
  :root[data-mjourney] #more-panel { display: block !important; margin-top: 0.3rem; }
  :root[data-mjourney] #stage { padding: 0.55rem 0.9rem; }
  :root[data-mjourney] .back,
  :root[data-mjourney] header .segmented { display: none !important; }
  :root[data-mjourney] #line-toggles {
    flex-wrap: nowrap; overflow-x: auto; max-width: calc(100vw - 2rem);
    white-space: nowrap; padding-bottom: .2rem;
  }
  :root[data-mjourney] .mj-research-tools { display: flex; align-items: center; font-size: .83rem; padding: .3rem 0; }
  :root[data-mjourney] .mj-research-tools label { display: flex; align-items: center; gap: .5rem; }
  :root[data-mjourney] #mj-moment-picker { max-width: min(40vw, 250px); min-width: 160px; font: inherit; padding: .35rem; background: var(--map-bg); color: var(--text); }
  :root[data-mjourney] #stage { position: relative; }
  :root[data-mjourney] .mj-stage-strip {
    position: absolute; top: 0; left: 0; width: 100%; height: 43px;
    z-index: 3; pointer-events: none;
    background: linear-gradient(to bottom, var(--bg) 0%, var(--bg) 64%, transparent 100%);
  }
  :root[data-mjourney] .mj-stage-name {
    position: absolute; top: 5px; transform: translateX(-50%);
    display: block; text-align: center; line-height: 1.12;
    font-size: clamp(9px, .85vw, 12px); font-weight: 650;
    max-height: 35px; overflow: hidden; overflow-wrap: break-word;
    color: var(--text); opacity: .86;
  }
  :root[data-mjourney] #lines .mj-subdued-category-shortcut {
    opacity: .18 !important;
  }
  :root[data-mjourney] .mj-stage-active {
    background: var(--text); color: var(--bg); border-radius: 3px;
    opacity: 1; font-weight: 800; padding: 2px 0;
  }
  :root[data-mjourney] .mj-stage-control {
    display: inline-flex; gap: .3rem; align-items: center; white-space: nowrap;
  }
  :root[data-mjourney] #mj-stage-picker {
    font: inherit; min-width: 110px; max-width: 160px;
    padding: .32rem .35rem; color: var(--text);
    background: var(--map-bg);
  }
  @media (max-width: 1080px) {
    :root[data-mjourney] .mj-stage-name {
      font-size: 11px; font-weight: 780;
      letter-spacing: .03em; line-height: 1.2;
    }
    :root[data-mjourney] #mj-stage-picker { max-width: 135px; }
  }

  :root[data-mjourney] .mj-research-tools { flex-wrap: wrap; gap: .35rem 1rem; }
  :root[data-mjourney] .mj-focus-tools { display: flex; align-items: center; flex-wrap: wrap; gap: .4rem; }
  :root[data-mjourney] .mj-focus-tools label { display: flex; align-items: center; gap: .4rem; }
  :root[data-mjourney] #mj-focus-select {
    font: inherit; padding: .32rem; max-width: 190px; min-width: 135px;
    color: var(--text); background: var(--map-bg);
  }
  :root[data-mjourney] .mj-focus-note { font-size: .72rem; opacity: .72; }

  /* The portfolio frame has a fixed viewport: reserve real space for the map.
     Keep native SVG Fit, never crop stations or add a second geometry solver. */
  :root[data-mjourney] body {
    display: flex; flex-direction: column; height: 100dvh; overflow: hidden;
  }
  :root[data-mjourney] header {
    flex: 0 0 auto; position: relative;
    padding: .38rem 1rem .25rem;
  }
  :root[data-mjourney] #more-panel { margin-top: .2rem; }
  :root[data-mjourney] .panel-row { flex-wrap: nowrap; padding: .12rem 0; gap: .6rem; }
  :root[data-mjourney] .panel-row #line-toggles {
    flex: 1 1 auto; min-width: 0; max-width: none;
  }
  :root[data-mjourney] .mj-research-tools {
    flex-wrap: nowrap; padding: .18rem 0; gap: .6rem;
  }
  :root[data-mjourney] .mj-focus-tools { flex-wrap: nowrap; }
  :root[data-mjourney] #stage {
    display: grid; place-items: center;
    flex: 1 1 auto; min-height: 0; height: auto;
    overflow: hidden;
  }
  :root[data-mjourney] #stage svg {
    width: 100%; height: 100%;
  }
  @media (max-width: 1080px) {
    :root[data-mjourney] .mj-focus-note { display: none; }
    :root[data-mjourney] #mj-moment-picker { max-width: 185px; }
    :root[data-mjourney] #mj-focus-select { max-width: 155px; }
  }
  @media (max-width: 650px) {
    :root[data-mjourney] .mj-research-tools { flex-wrap: wrap; }
    :root[data-mjourney] .mj-focus-tools { flex-wrap: wrap; }
    :root[data-mjourney] header .sub { display: none; }
  }

  /* Native tiny 1850-unit SVG names are replaced by clear pixel-scale
     research labels. Underlying marker coordinates and topology never move. */
  :root[data-mjourney-inspector] #linear-labels text { visibility: hidden !important; }
  :root[data-mjourney-inspector] #mj-readable-labels {
    position: absolute; inset: 0; overflow: hidden;
    pointer-events: none; z-index: 4;
  }
  :root[data-mjourney-inspector] .mj-readable-label {
    position: absolute; display: inline-block;
    width: max-content; max-width: 112px;
    font-size: clamp(11px, .86vw, 12.8px);
    font-weight: 650; line-height: 1.13;
    color: var(--text);
    white-space: normal; overflow-wrap: break-word;
    text-shadow: 0 1px var(--bg), 1px 0 var(--bg),
                 0 -1px var(--bg), -1px 0 var(--bg),
                 0 2px 3px var(--bg);
    text-align: center;
  }
  :root[data-mjourney-inspector] .mj-selected-label {
    font-weight: 800; text-decoration: underline;
    text-underline-offset: 2px;
  }
  :root[data-mjourney-inspector] #mj-label-controls {
    display: inline-flex; gap: 0; border: 1px solid var(--border);
    border-radius: 6px; overflow: hidden; white-space: nowrap;
    flex: 0 0 auto;
  }
  :root[data-mjourney-inspector] #mj-label-controls button {
    padding: .23rem .45rem; font-size: .76rem; border: 0;
  }
  :root[data-mjourney-inspector] #mj-label-controls button + button {
    border-left: 1px solid var(--border);
  }
  :root[data-mjourney-inspector] #mj-label-controls button[aria-pressed="true"] {
    background: var(--text); color: var(--bg);
  }
  @media (max-width: 1080px) {
    :root[data-mjourney-inspector] .mj-readable-label { font-size: 11.5px; }
  }
  :root[data-mjourney] .mj-inspector[hidden] { display: none !important; }
  :root[data-mjourney] .mj-inspector {
    position: fixed; right: 1rem; bottom: 1rem; z-index: 40;
    width: min(370px, calc(100vw - 2rem)); max-height: min(440px, 70vh);
    overflow: auto; padding: .8rem 1rem; border: 1px solid var(--text);
    border-radius: .6rem; background: var(--bg); color: var(--text);
    box-shadow: 0 6px 25px #0005; font-size: .85rem; line-height: 1.35;
  }
  :root[data-mjourney] .mj-inspector-head { display: flex; align-items: start; justify-content: space-between; gap: 1rem; }
  :root[data-mjourney] .mj-inspector h2 { font-size: 1.04rem; margin: 0 0 .6rem; }
  :root[data-mjourney] .mj-inspector h3 { font-size: .88rem; margin: .8rem 0 .3rem; }
  :root[data-mjourney] .mj-inspector p { margin: .25rem 0; }
  :root[data-mjourney] .mj-inspector ul { margin: .25rem 0; padding-left: 1.3rem; }
  :root[data-mjourney] .mj-inspector li { margin-bottom: .25rem; }
  :root[data-mjourney] .mj-inspector-muted { opacity: .8; }
  :root[data-mjourney] .mj-inspector button { font: inherit; padding: .25rem .45rem; }

  /* Composed map + inspector. A selected research record owns a real panel;
     it never overlays the stage or clips a source-backed route. */
  :root[data-mjourney-inspector] .mj-research-workspace {
    flex: 1 1 auto; min-height: 0; min-width: 0;
    display: flex; flex-direction: row; overflow: hidden;
  }
  :root[data-mjourney-inspector] .mj-research-workspace #stage {
    flex: 1 1 0; width: 0; min-width: 0; min-height: 0; height: auto;
  }
  :root[data-mjourney-inspector] .mj-research-workspace .mj-inspector {
    position: relative; inset: auto;
    box-sizing: border-box; flex: 0 0 min(340px, 28vw);
    width: auto; min-width: 0; height: auto; max-height: none;
    overflow: auto; margin: 0; padding: .75rem .85rem;
    border: 0; border-left: 1px solid var(--border);
    border-radius: 0; box-shadow: none;
    background: var(--bg);
    scrollbar-gutter: stable;
  }
  @media (max-width: 1090px) {
    :root[data-mjourney-inspector] .mj-research-workspace {
      flex-direction: column;
    }
    :root[data-mjourney-inspector] .mj-research-workspace #stage {
      width: 100%; flex: 1 1 auto; min-height: 175px;
    }
    :root[data-mjourney-inspector] .mj-research-workspace .mj-inspector {
      width: 100%; max-width: none; min-height: 0; max-height: 132px;
      flex: 0 0 132px; border-left: 0; border-top: 1px solid var(--border);
      padding: .5rem .85rem;
    }
    :root[data-mjourney-inspector] .mj-inspector h2 {
      font-size: .95rem;
    }
  }

"""
    if "</style>" not in page:
        raise ValueError("Legible Cities HTML has no style seam")
    page = page.replace("</style>", css + "</style>", 1)
    if research_contract is not None:
        # JSON stays inert. Escape markup-significant characters before
        # embedding the sanitized canonical source and audit in the viewer.
        payload = json.dumps(research_contract, ensure_ascii=False,
                             separators=(",", ":"))
        payload = (payload.replace("&", "\\u0026").replace("<", "\\u003c")
                   .replace(">", "\\u003e"))
        inspector = (ROOT / "src/schematic/page/mjourney_inspector.js").read_text(
            encoding="utf-8")
        scene = (ROOT / "src/schematic/page/mjourney_scene.js").read_text(
            encoding="utf-8")
        label_hierarchy = (ROOT / "src/schematic/page/mjourney_labels.js").read_text(
            encoding="utf-8")
        corridor_router = (ROOT / "src/schematic/page/mjourney_corridor_router.js").read_text(
            encoding="utf-8")
        page = page.replace(
            "</html>",
            '<script id="mjourney-research" type="application/json">'
            + payload + '</script>\n<script>\n' + inspector
            + '\n</script>\n<script>\n' + corridor_router
            + '\n</script>\n<script>\n' + scene
            + '\n</script>\n<script>\n' + label_hierarchy
            + '\n</script>\n</html>', 1)
    return page


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", type=Path, default=DEFAULT_SOURCE)
    parser.add_argument("--output", type=Path,
                        default=ROOT / "out/mjourney-equipment-schematic.svg")
    parser.add_argument("--system-v3", action="store_true",
                        help="Native System schematic with stable seven-line category membership")
    parser.add_argument("--stage-demand-corridors", action="store_true",
                        help="Experimental source-demand category spacing and centered stage-safe guide steps")
    parser.add_argument("--network", action="store_true",
                        help="Use actual authored graph topology and cross-layer transitions")
    parser.add_argument("--full", action="store_true",
                        help="Show all eligible source edges rather than a readable focused subset")
    parser.add_argument("--html", action="store_true",
                        help="Also create the upstream Legible Cities Schematic/Linear viewer")
    parser.add_argument("--width", type=float, default=1850.0)
    parser.add_argument("--focus-path", action="append", default=[],
                        metavar="ID=EDGE_ID,EDGE_ID",
                        help="Research-only directed focus chain, e.g. ae=edge44,edge48,edge49,edge50")
    args = parser.parse_args(argv)

    source = json.loads(args.source.read_text(encoding="utf-8"))
    if args.focus_path and not args.system_v3:
        parser.error("--focus-path requires --system-v3")
    if args.stage_demand_corridors and not args.system_v3:
        parser.error("--stage-demand-corridors requires --system-v3")
    focus_paths = []
    for entry in args.focus_path:
        name, sep, chain = entry.partition("=")
        if not sep or not name or not chain:
            parser.error("--focus-path requires ID=EDGE_ID,EDGE_ID")
        focus_paths.append({"id": name, "sourceEdgeIds": chain.split(",")})
    if args.system_v3 or args.network:
        projection = (build_system_v3(
            source, stage_demand_corridors=args.stage_demand_corridors)
                      if args.system_v3
                      else build_network_projection(source, full=args.full))
        # CDMX-equivalent warm-dark theme, using native Legible Cities styles.
        style = Style(
            background="#1f1915", station_fill="#f2ede6",
            station_stroke_color="#15120f", label_color="#f2ede6",
            line_width=10, line_gap=1.55,
            station_radius=4.5, interchange_radius=6.2,
            station_stroke=2, label_size=11.5, label_offset=10,
            padding=17, themed=True,
        )
        palette = {
            layer["name"]: layer["color"] for layer in projection.layers
        }
    else:
        selection = [m["id"] for m in source["moments"]] if args.full else None
        projection = from_json(args.source, station_ids=selection)
        style = Style()
        palette = {layer["name"]: layer["color"] for layer in projection.layers}
    order = [layer["name"] for layer in projection.layers]
    result = render(projection.graph, width=args.width, style=style,
                    line_order=order, colors=palette)
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(result.svg, encoding="utf-8")
    audit = args.output.with_suffix(".audit.json")
    # Authoritative research graph stays distinct from LineGraph's category
    # tracks and from the upstream browser's transit route planner.
    research_contract = None
    if args.system_v3:
        research_contract = build_system_contract(
            source, projection, focus_paths=focus_paths)
        research_file = args.output.with_suffix(".research.json")
        research_file.write_text(json.dumps(research_contract, indent=2,
                                            ensure_ascii=False) + "\n",
                                 encoding="utf-8")
    report = dict(projection.audit)
    report["render"] = {
        "engine": "schematic.render.render (original Legible Cities)",
        "stations": len(projection.graph.stations),
        "tracks": len(result.tracks),
        "droppedLabels": result.dropped_labels,
        "svg": args.output.name,
        "timetable": None,
        "routingEnabled": False,
        "internalTransitNetworkBuiltByUpstream": False,
        "passengerTripPickerSuppressed": bool(args.html),
        "researchNavigationImplemented": bool(args.system_v3 and args.html),
        "stageConstraintStatus": (
            "source-demand stage corridors; ordinal stage containment and "
            "native display visual review required"
            if args.stage_demand_corridors else
            "source-index layout stage gutters; editorial visual review required"
            if args.network or args.system_v3 else "coordinate seeds only; visual review required"),
    }
    if research_contract is not None:
        report["researchContract"] = {
            "file": research_file.name,
            "canonicalSemanticSha256": research_contract["canonicalSemanticSha256"],
            "sourceRelationshipCount": research_contract["integrity"]["sourceRelationshipCount"],
            "categoryGuidesNavigable": False,
            "focusSequencesAreCustomerItineraries": False,
            "sourceAuthorityComesFromGeometry": False,
        }
    if args.html:
        anim = animate.build(result, projection.graph, [], dt.date(2026, 11, 2),
                             line_order=order)
        page = animate.texts(
            anim, result.svg, stem=args.output.stem,
            title=("B2B channel journey | M-Journey" if source["journeyId"] == "b2b-starter"
                   else "Equipment buying journey | M-Journey"),
            name=("B2B channel journey" if source["journeyId"] == "b2b-starter"
                  else "Equipment buying journey"),
            subtitle=("Category guides · research connections in details"
                      if args.system_v3 else "Authored research graph preview"),
            back="https://github.com/sss2808/legible-cities/pull/1",
        )[f"{args.output.stem}.html"]
        viewer = args.output.with_suffix(".html")
        viewer.write_text(viewer_for_journey(page, research_contract), encoding="utf-8")
        report["render"]["viewer"] = viewer.name
        report["render"]["viewerModes"] = (["system"] if args.system_v3 else ["source-network-preview"])
        print(f"Native interactive viewer: {viewer}")
    audit.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
    print(f"SVG: {args.output}")
    print(f"Audit: {audit}")
    print(f"{len(projection.graph.stations)} stations; {len(result.tracks)} tracks; "
          f"{len(result.dropped_labels)} dropped labels")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
