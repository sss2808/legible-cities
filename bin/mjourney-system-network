def main():
    ap=argparse.ArgumentParser()
    ap.add_argument("--source",type=Path,default=ROOT/"fixtures/mjourney/equipment-sanitized-v1.json")
    ap.add_argument("--output",type=Path,default=Path("out/cartographic-line-proof"))
    group=ap.add_mutually_exclusive_group()
    group.add_argument("--native-loom",action="store_true",
                       help="Run loom and octi with full native acceptance gates")
    group.add_argument("--native-line-order-only",action="store_true",
                       help="Run loom only; show source-preserving seed geometry and native line ordering")
    ap.add_argument("--timeout",type=int,default=240)
    args=ap.parse_args()
    raw=args.source.read_bytes()
    source=json.loads(raw)
    # P0a: never regenerate a self-validating baseline from modified input.
    manifest=build_source_manifest(source,ROUTES,source_bytes=raw)
    lock=json.loads((ROOT/"fixtures/mjourney/equipment-source-certificate-lock-v7.json").read_text())
    if (manifest["sourceBytesSha256"]!=lock["sourceBytesSha256"] or
        manifest["semanticSha256"]!=lock["sourceSemanticSha256"] or
        manifest["canonicalCounts"]!=lock["canonicalCounts"] or
        manifest["projectionCounts"]!=lock["projectionCounts"]):
        raise ValueError("P0a source baseline drift: review fixture and V7 projection before native LOOM")
    moments,connections=source_records(source)
    seed=assemble(source)
    seed_review=validate_projection_graph(seed,manifest,require_source_edge_ids=True)
    if not seed_review["passed"]:
        raise ValueError("P0a projection failed: "+"; ".join(seed_review["errors"]))
    args.output.parent.mkdir(parents=True,exist_ok=True)
    if args.native_loom:
        graph,solver=native_geometry(seed,source,args.output,args.timeout,manifest)
    elif args.native_line_order_only:
        graph,solver=native_line_order_geometry(seed,source,args.output,args.timeout,manifest)
    else:
        graph=seed
        solver={"attempted":False,"used":False,"reviewStatus":"Deterministic seed geometry only; awaiting native LOOM review"}
    if solver.get("attempted") and not solver.get("lineOrderUsed"):
        solver["reviewStatus"]=("Native octi geometry accepted" if solver["used"] else
                 "Native octi candidate REJECTED; displayed source-preserving seed")
    assert adjacency(graph)==adjacency(seed)
    assert {n.station_id for n in graph.stations}==set(SEEDS)
    assert set(graph.labels)=={l.label for l in LINES.values()}
    if solver.get("used"):assert poly_review(graph)["octilinear"]
    # Use original Legible Cities renderer on accepted LOOM geometry, not a
    # custom hand-built SVG track/path engine.
    result=render(graph,width=2350,style=Style(
        background="#211b17",station_fill="#fff4df",station_stroke_color="#211b17",
        label_color="#fff4df",line_width=8.5,line_gap=1.95,station_radius=6.2,
        interchange_radius=8.5,station_stroke=3,label_size=17,
        label_offset=12,padding=64,themed=True
       ),line_order=[l.label for l in LINES.values()],
       colors={l.label:l.color for l in LINES.values()})
    svg=svg_with_stages(result.svg,graph,source)
    audit={"reviewStatus":"full-lifecycle research systems map; owner topology and visual review required",
      "canonical":{"moments":67,"authoredEdges":87,"edited":False},
      "sourceCertificate":{"semanticSha256":manifest["semanticSha256"],
                           "sourceBytesSha256":manifest["sourceBytesSha256"],
                           "strictPreSolverPassed":seed_review["passed"],
                           "selectedProjection":manifest["projectionCounts"],
                           "interpretation":"11 visual route identities are V7 geometry diagnostic, not final product layer lines"},
      "projection":{"displayMoments":len(seed.stations),"displayAuthoredConnections":len(TRACK_IDS),
          "activeStages":stage_review(graph,source)["present"],"lineCount":len(LINES),
          "sourceEdgeIds":TRACK_IDS,"sharedCorridorSourceEdges":SHARED_PREFIX+SHARED_SUFFIX,
          "aePathSourceEdges":SHARED_PREFIX+AE+SHARED_SUFFIX,
          "directPathSourceEdges":SHARED_PREFIX+DIRECT+SHARED_SUFFIX,
          "singleCanonicalStationPerMoment":True,"approvedInterchanges":[],
          "unapprovedSyntheticEdges":0,"authoredResearchLayers":len(source["layers"]),
          "journeySequenceIsNotOrganizationalWorkstream":True,
          "routeFamilies":ROUTES,
          "includedHandoffEdgeIds":[eid for eid in TRACK_IDS if connections[eid]["kind"]=="handoff"],
          "classification":"Candidate selection routes and shorter authored activity chains, not validated customer travel"},
      "solver":solver,"integrity":{"stationAdjacencyPreserved":adjacency(graph)==adjacency(seed),
          "stagePreserved":stage_review(graph,source)["preserved"],
          "lineIdentitiesPreserved":True,
          "nativePolylinesUsedVerbatim":bool(solver.get("used") or solver.get("lineOrderUsed")),
          "nativeOctiGeometryAccepted":bool(solver.get("used")),
          "nativeLineOrderingAccepted":bool(solver.get("lineOrderUsed")),
          "noTransitTimes":True},
      "renderer":{"source":"schematic.render.render", "labelsDropped":result.dropped_labels}}
    args.output.with_suffix(".svg").write_text(svg)
    args.output.with_suffix(".html").write_text(page(svg,graph,source,audit))
    args.output.with_suffix(".audit.json").write_text(json.dumps(audit,indent=2)+"\n")
    print(json.dumps({"output":str(args.output),"solver":solver,
       "stations":len(graph.stations),"trackEdges":len(graph.edges),
       "renderTracks":len(result.tracks),"labelsDropped":result.dropped_labels},indent=2))
if __name__=="__main__":main()
