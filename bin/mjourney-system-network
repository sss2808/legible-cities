#!/usr/bin/env python3
"""Ten-stage, source-backed research system map with native Legible Cities renderer.
This is NOT an edit to the canonical 67/87 research graph or a licensed
customer journey traversal. Research IDs and line/edge provenance are audited.
The network displays selected continuous authored routes without invented transfers.
"""
from __future__ import annotations

import argparse
from collections import Counter, defaultdict, deque
from dataclasses import dataclass
from hashlib import sha256
from pathlib import Path
import html
import json
import math
import sys
import xml.etree.ElementTree as ET

ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT/"src"))
from schematic import loom
from schematic.linegraph import Edge, Line, LineGraph, Node
from schematic.render import Style, render, octilinearity
from schematic.mjourney_projection import to_solver_point, from_solver_point
from schematic.mjourney_source_integrity import (
    build_source_manifest, validate_projection_graph,
)

# Visual transit-line identities describe explicit continuous edge chains. These
# are not automatically customer personas, organizational workstreams or transfers.
LINES={
  "ae_epc_mediated":Line("ae_epc_mediated","A&E / EPC mediated","#f1729f"),
  "direct_customer_led":Line("direct_customer_led","Direct customer-led","#3bc9de"),
  "technical_feasibility":Line("technical_feasibility","Technical feasibility","#d9ba67"),
  "concept_documentation":Line("concept_documentation","Concept documentation","#aaa1db"),
  "business_case_costing":Line("business_case_costing","Business case costing","#e7a778"),
  "technical_approval":Line("technical_approval","Technical approval","#92b7c6"),
  "financial_review":Line("financial_review","Financial review","#bda2ff"),
  "site_readiness":Line("site_readiness","Site readiness","#69c6a0"),
  "logistics_readiness":Line("logistics_readiness","Logistics readiness","#f1bd81"),
  "validation_strategy":Line("validation_strategy","Validation strategy","#a0c778"),
  "handover_documentation":Line("handover_documentation","Handover documentation","#c6b8a1")
}
SHARED_PREFIX=["edge01","edge02","edge04","edge06","edge09","edge13","edge16",
 "edge21","edge22","edge27","edge33","edge34","edge38","edge43"]
AE=["edge44","edge48","edge49","edge50"]
DIRECT=["edge45","edge51","edge52"]
SHARED_SUFFIX=["edge53","edge54","edge55","edge56","edge60","edge61","edge62",
 "edge66","edge67","edge68","edge69","edge70","edge71","edge72","edge73",
 "edge74","edge75","edge76","edge77","edge78","edge80","edge82","edge83",
 "edge84","edge85","edge86"]
ROUTES={
  "ae_epc_mediated":SHARED_PREFIX+AE+SHARED_SUFFIX,
  "direct_customer_led":SHARED_PREFIX+DIRECT+SHARED_SUFFIX,
  "technical_feasibility":["edge07","edge11","edge17"],
  "concept_documentation":["edge15","edge18"],
  "business_case_costing":["edge25","edge28","edge31"],
  "technical_approval":["edge35","edge40"],
  "financial_review":["edge37","edge39","edge42"],
  "site_readiness":["edge57","edge63"],
  "logistics_readiness":["edge59","edge64"],
  "validation_strategy":["edge58","edge65"],
  "handover_documentation":["edge79","edge81"]
}
TRACK_IDS=list(dict.fromkeys(eid for chain in ROUTES.values() for eid in chain))
SEEDS={}
# Layout semantics: x is the authored ten-stage ordinal; y is the actual
# research layer, with Journey sequence (layer-0) centered in the field.
# This does not infer physical place, duration, stakeholder travel or transfers.
ROW_Y={"layer-0":670,"layer-1":370,"layer-2":535,"layer-3":790,
       "layer-4":935,"layer-5":1080,"layer-6":1210}

def seed_poly(a,b):
    """Minimum-bend octilinear fallback for a single authorized source edge.

    No intermediate coordinates are research stations or connection claims.
    Native LOOM geometry, if accepted, bypasses this entirely.
    """
    x0,y0=a;x1,y1=b
    dx=x1-x0;dy=y1-y0
    ax,ay=abs(dx),abs(dy)
    if ax<1e-7 or ay<1e-7 or abs(ax-ay)<1e-7:
        return [a,b]
    sx=1 if dx>=0 else -1
    sy=1 if dy>=0 else -1
    if ax>ay:
        # One diagonal and one horizontal; avoid two symmetric zig-zag bends.
        mid=(x0+sx*ay,y1)
    else:
        # One vertical and one diagonal to retain 45-degree directions.
        mid=(x0,y0+sy*(ay-ax))
    return [a,mid,b]

def source_records(source):
    assert len(source["moments"])==67 and len(source["connections"])==87
    moments={x["id"]:x for x in source["moments"]}
    edges={e["id"]:e for e in source["connections"]}
    assert len(TRACK_IDS)==68 and len(ROUTES)==len(LINES)
    for lid,chain in ROUTES.items():
        assert chain and len(chain)==len(set(chain)),f"repeated source edge in {lid}"
        for eid in chain:
            assert eid in edges and edges[eid]["kind"] in {
                "sequence","branch","convergence","handoff"},f"unauthorized {eid}"
        for a,b in zip(chain,chain[1:]):
            assert edges[a]["toId"]==edges[b]["fromId"],f"broken authored route {lid}: {a} => {b}"
    required={node for eid in TRACK_IDS for node in
              (edges[eid]["fromId"],edges[eid]["toId"])}
    assert len(required)==59
    assert {m["stageId"] for mid,m in moments.items() if mid in required}=={
        s["id"] for s in source["stages"]}
    assert all(e["kind"]!="lifecycle_return" for e in
               (edges[eid] for eid in TRACK_IDS))
    SEEDS.clear()
    for stage in sorted(source["stages"],key=lambda s:s["order"]):
        present=sorted((m for m in source["moments"]
                        if m["id"] in required and m["stageId"]==stage["id"]),
                       key=lambda m:int(m["id"][2:]))
        for i,m in enumerate(present):
            fraction=(i+.5)/len(present)
            SEEDS[m["id"]]=(120+stage["order"]*330+fraction*250,
                            ROW_Y[m["layerId"]])
    assert len(SEEDS)==len(required)
    return moments,edges

def assemble(source):
    moments,edges=source_records(source)
    nodes={mid:Node(id=mid,coord=xy,station_id=mid,
                    station_label=moments[mid]["label"],
                    props={"stageId":moments[mid]["stageId"],
                           "sourceMomentId":mid,"sourceLayerId":moments[mid]["layerId"]})
           for mid,xy in SEEDS.items()}
    drawn=[]
    for eid in TRACK_IDS:
        e=edges[eid]
        carrying=[LINES[lid] for lid,chain in ROUTES.items() if eid in chain]
        assert carrying
        a,b=e["fromId"],e["toId"]
        drawn.append(Edge(src=a,dst=b,geometry=seed_poly(SEEDS[a],SEEDS[b]),
                   lines=carrying,props={"sourceEdgeIds":[eid],"sourceKind":e["kind"],
                     "projectionRole":("candidate-pathway-track" if any(
                       lid in ("ae_epc_mediated","direct_customer_led") for lid,chain
                       in ROUTES.items() if eid in chain) else "authored-activity-track"),
                     "traversable":False}))
    return LineGraph(nodes,drawn)

# The diagram axes are synthetic ordinal layout units, never locations.
# LOOM ingests WGS84 but optimizes in Web Mercator metres. Reuse the exact
# reversible bridge from verified PR #6. No approximate latitude scaling.
def to_solver(graph):
    return graph.reproject(to_solver_point)


def from_solver(graph):
    # Preserve every intermediate point introduced by native loom/octi.
    return graph.reproject(from_solver_point)


def adjacency(graph):
    # Stops joined via geometry-only junctions count as adjacent iff the
    # chosen line meets no other station in between. This is an UNDIRECTED
    # *cartographic track* check; route direction remains in source chains.
    byline=defaultdict(lambda:defaultdict(set))
    for e in graph.edges:
        for line in e.lines:
            byline[line.id][e.src].add(e.dst)
            byline[line.id][e.dst].add(e.src)
    out={}
    for lid,links in byline.items():
        connected=set()
        for station in graph.stations:
            if station.id not in links:continue
            todo=[station.id];seen={station.id}
            while todo:
                here=todo.pop()
                for nxt in links[here]:
                    if nxt in seen:continue
                    seen.add(nxt)
                    other=graph.nodes[nxt]
                    if other.station_id:
                        connected.add(tuple(sorted((station.station_id,other.station_id))))
                    else:todo.append(nxt)
        out[lid]=connected
    return out

def stage_review(graph,source):
    byid={m["id"]:m for m in source["moments"]}
    order={s["id"]:s["order"] for s in source["stages"]}
    groups=defaultdict(list)
    for node in graph.stations:groups[byid[node.station_id]["stageId"]].append(node.coord[0])
    present=sorted(groups,key=lambda x:order[x])
    bounds={sid:(min(xs),max(xs)) for sid,xs in groups.items()}
    # Nodes may shift within their stage; no station may migrate to an earlier
    # stage domain, and source ordinal order must stay left to right.
    violations=[]
    for left,right in zip(present,present[1:]):
        if bounds[left][1]+4>=bounds[right][0]:
            violations.append(f"interleaved stages {left} and {right}")
    return {"preserved":not violations,"bounds":bounds,"violations":violations,
            "present":present,"fullCanonicalStageCount":len(source["stages"])}

def poly_review(graph):
    """The upstream renderer's projected length-weighted octilinearity gate.

    Reject a nonempty solved graph unless >=99.5% of geometric length falls
    within one degree of an octilinear (45-degree multiple) direction.
    """
    ok,total=octilinearity(graph,tol_deg=1.0)
    fraction=ok/total if total>0 else 0.0
    return {"octilinear":math.isfinite(fraction) and total>0 and fraction>=0.995,
            "lengthWeightedFraction":round(fraction,8),
            "minimumAcceptedFraction":0.995,"angleToleranceDegrees":1.0,
            "acceptedLength":round(ok,4),"totalLength":round(total,4),
            "polylinePoints":sum(len(e.geometry) for e in graph.edges),
            "method":"schematic.render.octilinearity in exact diagram metric axes"}


def native_geometry(seed,source,path,timeout,manifest):
    geo=to_solver(seed).to_geojson()
    path.with_suffix(".input.geojson").write_text(json.dumps(geo,indent=2)+"\n")
    stages={}
    for name in ["loom","octi"]:
        geo=loom.run(name,geo,timeout=timeout)
        path.with_suffix("."+name+".geojson").write_text(json.dumps(geo,indent=2)+"\n")
        stages[name]={"featureCount":len(geo.get("features",[])),
                      "hash":sha256(json.dumps(geo,sort_keys=True).encode()).hexdigest()}
    solved=from_solver(LineGraph.from_geojson(geo))
    # Source-edge direction is frozen in the P0a manifest. Native geometry
    # can preserve undirected station adjacency without preserving provenance.
    # Never claim this structural review certifies directed edge identities.
    semantic_review=validate_projection_graph(
        solved,manifest,require_source_edge_ids=False)

    source_pairs=adjacency(seed)
    target_pairs=adjacency(solved)
    lost={l:sorted(source_pairs[l]-target_pairs.get(l,set())) for l in source_pairs}
    gained={l:sorted(target_pairs.get(l,set())-source_pairs[l]) for l in source_pairs}
    equal=all(not x for x in lost.values()) and all(not x for x in gained.values())
    expected={n.station_id for n in seed.stations}
    actual={n.station_id for n in solved.stations}
    stations=(expected==actual and len(expected)==len(solved.stations))
    canonical_stage=stage_review(solved,source)
    angles=poly_review(solved)
    identities={line.id for e in solved.edges for line in e.lines}==set(LINES)
    accepted=(equal and stations and identities and
              semantic_review["passed"] and canonical_stage["preserved"] and
              angles["octilinear"])
    proof={"attempted":True,"used":accepted,"steps":stages,
           "adjacencyPreserved":equal,"stationIdentityPreserved":stations,
           "lineIdentityPreserved":identities,"stageReview":canonical_stage,
           "sourceSemanticSha256":manifest["semanticSha256"],
           "postSolverSourceReview":semantic_review,
           "sourceDirectionReconstructed":False,
           "coordinateBridge":"exact_synthetic_web_mercator_pr6",
           "topologyStageEnabled":False,
           "octilinearReview":angles,"lostStationLinePairs":lost,
           "addedStationLinePairs":gained,
           "geometryPolicy":"Use solver's exact edge polylines or reject; never re-elbow or guess transfers"}
    return (solved if accepted else seed),proof

def native_line_order_geometry(seed,source,path,timeout,manifest):
    """Run native LOOM line ordering only, not octi geometry optimization."""
    geo=to_solver(seed).to_geojson()
    path.with_suffix(".input.geojson").write_text(json.dumps(geo,indent=2)+"\n")
    ordered=loom.run("loom",geo,timeout=timeout)
    path.with_suffix(".loom.geojson").write_text(json.dumps(ordered,indent=2)+"\n")
    candidate=from_solver(LineGraph.from_geojson(ordered))
    structural=validate_projection_graph(candidate,manifest,require_source_edge_ids=False)
    stages=stage_review(candidate,source)
    angles=poly_review(candidate)
    lines={line.id for e in candidate.edges for line in e.lines}
    sid={n.station_id for n in candidate.stations}
    accepted=(structural["passed"] and stages["preserved"] and angles["octilinear"]
              and adjacency(candidate)==adjacency(seed)
              and len(candidate.stations)==len(seed.stations)
              and sid=={n.station_id for n in seed.stations}
              and lines==set(LINES))
    audit={
        "attempted":True,"used":False,"lineOrderUsed":accepted,
        "mode":"line_order_only","octiAttempted":False,
        "coordinateBridge":"exact_synthetic_web_mercator_pr6",
        "topologyStageEnabled":False,"sourceDirectionReconstructed":False,
        "sourceSemanticSha256":manifest["semanticSha256"],
        "postSolverSourceReview":structural,"stageReview":stages,
        "octilinearReview":angles,
        "adjacencyPreserved":adjacency(candidate)==adjacency(seed),
        "stationIdentityPreserved":sid=={n.station_id for n in seed.stations}
                                   and len(candidate.stations)==len(seed.stations),
        "lineIdentityPreserved":lines==set(LINES),
        "reviewStatus":("Native LOOM line ordering used on source-constrained seed; "
                        "octi not run or accepted" if accepted else
                        "LOOM line ordering rejected; displayed deterministic seed"),
    }
    return (candidate if accepted else seed),audit


def svg_with_stages(original,graph,source):
    ET.register_namespace("","http://www.w3.org/2000/svg")
    namespace="{http://www.w3.org/2000/svg}"
    root=ET.fromstring(original)
    circles=root.findall(".//"+namespace+"circle")
    positions={c.attrib["data-station-id"]:(float(c.attrib["cx"]),float(c.attrib["cy"]))
               for c in circles if c.attrib.get("data-station-id")}
    assert len(positions)==len(SEEDS)
    byid={m["id"]:m for m in source["moments"]}
    layer_byid={l["id"]:l for l in source["layers"]}
    handoff_targets={e["toId"] for e in source["connections"] if
                     e["kind"]=="handoff" and e["id"] in TRACK_IDS}
    for c in circles:
        sid=c.attrib.get("data-station-id")
        if not sid:continue
        layer=layer_byid[byid[sid]["layerId"]]
        c.set("data-layer",layer["id"])
        c.set("data-key","true" if byid[sid]["key"] else "false")
        c.set("data-handoff","true" if sid in handoff_targets else "false")
        c.set("tabindex","0")
        c.set("role","button")
        c.set("aria-label",byid[sid]["label"]+" · "+layer["name"])
        c.set("style",c.get("style","")+";stroke:"+layer["color"]+
              ";stroke-width:"+( "4.8" if sid in handoff_targets else "3.4"))
    # LOOM node IDs are *unstable* internal pointers. Resolve rendered label
    # data-node references back to canonical station IDs before assigning LOD.
    by_pointer={c.attrib.get("data-node"):c.attrib.get("data-station-id")
                for c in circles if c.attrib.get("data-station-id")}
    label_group=root.find(".//"+namespace+"g[@id='labels']")
    if label_group is not None:
        for el in label_group.findall(namespace+"text"):
            canonical=by_pointer.get(el.attrib.get("data-node"))
            if canonical:
                el.set("data-station-id",canonical)
                el.set("data-key","true" if byid[canonical]["key"] else "false")
                el.set("data-decision","true" if byid[canonical]["decision"] else "false")
    # Compute transform from actual source to renderer's SVG positions, not
    # pre-normalized assumptions or extra copies of station coordinates.
    def fit(axis):
        vals=[(n.coord[axis],positions[n.station_id][axis]) for n in graph.stations]
        mx=sum(x for x,_ in vals)/len(vals);my=sum(y for _,y in vals)/len(vals)
        a=sum((x-mx)*(y-my) for x,y in vals)/sum((x-mx)**2 for x,y in vals)
        b=my-a*mx
        err=max(abs(a*x+b-y) for x,y in vals)
        if err>3:raise ValueError(f"nonaffine renderer transform {axis}: {err:.2f}")
        return lambda x:a*x+b
    px=fit(0)
    byid={m["id"]:m for m in source["moments"]}
    stages={s["id"]:s for s in source["stages"]}
    groups=defaultdict(list)
    for mid,(x,y) in positions.items():groups[byid[mid]["stageId"]].append(x)
    ordering=sorted(groups,key=lambda sid:stages[sid]["order"])
    ybase=min(y for _,y in positions.values())-105
    top=ET.Element(namespace+"g",{"id":"stage-headings","aria-label":"Authored ordinal journey stages"})
    for sid in ordering:
        xs=groups[sid];center=(min(xs)+max(xs))/2
        ET.SubElement(top,namespace+"text",{"x":f"{center:.2f}","y":f"{ybase:.2f}",
              "text-anchor":"middle","fill":"#cfc1b5","font-size":"26",
              "font-weight":"700"}).text=stages[sid]["shortName"]
        ET.SubElement(top,namespace+"line",{"x1":f"{min(xs)-24:.2f}",
              "x2":f"{min(xs)-24:.2f}","y1":f"{ybase+18:.2f}",
              "y2":f"{max(y for _,y in positions.values())+42:.2f}",
              "stroke":"#a69887","stroke-width":"1","stroke-dasharray":"3 14",
              "opacity":"0.16"})
    # Authored research layers are station location bands, not transit routes.
    # In particular, layer-0 means Journey sequence rather than an organization.
    layer_y=defaultdict(list)
    for mid,(x,y) in positions.items():
        layer_y[byid[mid]["layerId"]].append(y)
    left_x=min(x for x,_ in positions.values())-205
    guide=ET.Element(namespace+"g",{"id":"research-layer-guides",
                       "aria-label":"Authored research layer bands"})
    for layer in source["layers"]:
        ys=layer_y.get(layer["id"],[])
        if not ys:continue
        cy=sorted(ys)[len(ys)//2]
        ET.SubElement(guide,namespace+"line",{
            "x1":f"{left_x+4:.1f}","x2":f"{max(x for x,_ in positions.values())+50:.1f}",
            "y1":f"{cy:.1f}","y2":f"{cy:.1f}",
            "stroke":layer["color"],"stroke-width":"1.5",
            "stroke-dasharray":"3 14","opacity":".19"})
        ET.SubElement(guide,namespace+"text",{
            "x":f"{left_x:.1f}","y":f"{cy-12:.1f}",
            "fill":"#d9cbb9","font-size":"17","font-weight":"600"}).text=layer["name"]
    root.insert(1,guide)
    root.insert(2,top)
    # Keep geometry stage guides on same canvas as native renderer.
    box=[float(x) for x in root.attrib["viewBox"].split()]
    topy=min(box[1],ybase-52)
    right=max(box[0]+box[2],max(x for x,_ in positions.values())+180)
    bottom=max(box[1]+box[3],max(y for _,y in positions.values())+100)
    viewleft=min(box[0]-20,left_x-18)
    root.set("viewBox",f"{viewleft:.2f} {topy:.2f} {right-viewleft+40:.2f} {bottom-topy:.2f}")
    root.set("id","metro")
    root.set("role","img")
    root.set("aria-label","Equipment buying system with ten research stages, two candidate selection pathways and authored activity branches")
    root.attrib.pop("width",None);root.attrib.pop("height",None)
    return ET.tostring(root,encoding="unicode")

def page(svg,graph,source,audit):
    full={m["id"]:m for m in source["moments"]}
    conn={e["id"]:e for e in source["connections"]}
    layer={l["id"]:l for l in source["layers"]}
    stage={s["id"]:s for s in source["stages"]}
    details={mid:{"id":mid,"label":full[mid]["label"],
                  "stage":stage[full[mid]["stageId"]]["shortName"],
                  "stageOrdinal":stage[full[mid]["stageId"]]["order"],
                  "layer":full[mid]["layerId"],
                  "researchLayer":layer[full[mid]["layerId"]]["name"],
                  "key":full[mid]["key"],"decision":full[mid]["decision"],
                  "evidence":full[mid]["evidenceClass"],
                  "evidenceRefPresent":full[mid]["evidenceRefPresent"],
                  "links":[{"id":eid,"kind":conn[eid]["kind"],
                            "from":conn[eid]["fromId"],"to":conn[eid]["toId"]}
                           for eid in TRACK_IDS if mid in (conn[eid]["fromId"],conn[eid]["toId"])]}
             for mid in SEEDS}
    route_stations={lid:[conn[chain[0]]["fromId"]]+
                  [conn[eid]["toId"] for eid in chain]
                  for lid,chain in ROUTES.items()}
    assert all(len(stops)==len(set(stops)) for stops in route_stations.values())
    payload=json.dumps({"moments":details,
       "routes":{lid:{"name":l.label,"color":l.color,"stationIds":route_stations[lid]}
                  for lid,l in LINES.items()},
       "researchLayers":{l["id"]:{"name":l["name"],"color":l["color"]}
                         for l in source["layers"]},
       "audit":audit},separators=(",",":")).replace("<","\\u003c")
    document=r"""<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>M-Journey equipment buying systems map</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600&family=Source+Sans+3:wght@500;600;700&display=swap');
:root{font-family:'Open Sans',Arial,sans-serif;background:#e9dec9;color:#28231f}
*{box-sizing:border-box}body{margin:0}button,select{font:inherit}
header{padding:22px clamp(16px,4vw,52px) 16px;max-width:1500px;margin:auto}
h1{font-family:'Source Sans 3',Arial,sans-serif;font-size:27px;font-weight:700;margin:0 0 6px}
header p{font-size:13px;color:#574c42;line-height:1.5;margin:0}
main{padding:0 clamp(8px,2vw,28px) 24px}
figure{margin:auto;max-width:1600px;position:relative;height:calc(100vh - 145px);min-height:610px;max-height:920px;overflow:hidden;background:#211b17;border:1px solid #b8a994}
figure:fullscreen{width:100vw;height:100vh;max-width:none;max-height:none;border:0}
#metro{display:block;width:100%;height:100%;touch-action:none;cursor:grab}
#metro.grabbed{cursor:grabbing}
#metro #lines path{stroke-linejoin:round;stroke-linecap:round}
#metro #lines g.line{transition:opacity .16s}
#metro #lines g.line.subdued{opacity:.1}
#metro #stations circle{cursor:pointer;transition:opacity .16s}
#metro #stations circle.subdued{opacity:.22}
#metro #stations circle.selected-station{r:11;stroke:#fff4da!important;stroke-width:5!important}
#metro #labels text{opacity:0;font-size:23px;paint-order:stroke;stroke:#211b17;stroke-width:3.5}
#metro #stage-headings text{font-size:29px;paint-order:stroke;stroke:#211b17;stroke-width:2}
.toolbar{position:absolute;top:12px;left:12px;right:12px;display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:10px;align-items:start;z-index:3;pointer-events:none}
.modes,.filters,.camera{display:flex;gap:6px;align-items:center;flex-wrap:wrap;pointer-events:auto}
.camera{justify-content:flex-end;flex-wrap:nowrap}
