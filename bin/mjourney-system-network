function mapAspect(){
 const b=svg.getBoundingClientRect();
 return Math.max(.35,b.width/Math.max(1,b.height));
}
function unionBoxes(items){
 let left=Infinity,top=Infinity,right=-Infinity,bottom=-Infinity;
 for(const el of items){
  if(!el||getComputedStyle(el).display==="none")continue;
  let r;try{r=el.getBBox()}catch(_){continue}
  if(!r||!Number.isFinite(r.x+r.y+r.width+r.height))continue;
  if(r.width===0&&r.height===0)continue;
  left=Math.min(left,r.x);top=Math.min(top,r.y);
  right=Math.max(right,r.x+r.width);bottom=Math.max(bottom,r.y+r.height);
 }
 if(!Number.isFinite(left))return {x:home.x,y:home.y,w:home.w,h:home.h};
 return {x:left,y:top,w:Math.max(1,right-left),h:Math.max(1,bottom-top)};
}
function selection(){
 const key=route.value,layerId=layer.value;
 const routeIds=key==="all"?allStations:new Set(data.routes[key].stationIds);
 const layerIds=new Set(circles.filter(c=>layerId==="all"||c.dataset.layer===layerId)
   .map(c=>c.dataset.stationId));
 const both=new Set([...routeIds].filter(id=>layerIds.has(id)));
 return {key,layerId,ids:both.size?both:routeIds};
}
function visibleContentBox(full=false){
 const state=selection(),all=full||(state.key==="all"&&state.layerId==="all");
 const members=all?allStations:state.ids;
 const visibleTracks=groups.filter(g=>full||(state.key==="all"&&state.layerId==="all")||
  (state.key!=="all"&&g.dataset.line===data.routes[state.key].name));
 const items=[...visibleTracks,...circles.filter(c=>members.has(c.dataset.stationId))];
 if(all){
  items.push(...svg.querySelectorAll("#stage-headings text,#research-layer-guides text"));
 }
 // Labels belong in the same camera as their tracks when they are shown.
 items.push(...labels.filter(t=>members.has(t.dataset.stationId)&&
   getComputedStyle(t).opacity!=="0"&&t.style.opacity!=="0"));
 return unionBoxes(items);
}
function fitBox(box,{focus=false}={}){
 const aspect=mapAspect();
 const padX=Math.max(38,box.w*.075),padY=Math.max(55,box.h*.09);
 // Short route subsets are allowed to occupy much of the frame, not become
 // microscopic or jump to a 10x close-up.
 const minimum=focus?baseline.w*(innerWidth<=760?.35:.45):0;
 const w=Math.max(box.w+2*padX,(box.h+2*padY)*aspect,minimum);
 const h=w/aspect;
 return {x:box.x+box.w/2-w/2,y:box.y+box.h/2-h/2+h*(innerWidth<=760?.02:.10),w,h};
}
function setView(v){
 if(![v.x,v.y,v.w,v.h].every(Number.isFinite)||v.w<=0||v.h<=0)return;
 view={...v};
 svg.setAttribute("viewBox",[v.x,v.y,v.w,v.h].map(x=>x.toFixed(3)).join(" "));
 if(mode==="schematic")updateLabels();
}
function mobileStageBox(){
 const first=new Set(Object.values(data.moments).filter(m=>m.stageOrdinal<=2).map(m=>m.id));
 const stations=circles.filter(c=>first.has(c.dataset.stationId));
 const headings=[...svg.querySelectorAll("#stage-headings text")].slice(0,3);
 return unionBoxes([...stations,...headings]);
}
function fitVisible(){
 if(mode==="linear"){
  linear.scrollLeft=0;linear.scrollTop=0;
  return;
 }
 const state=selection(),focus=state.key!=="all"||state.layerId!=="all";
 if(innerWidth<=760&&!focus){
  // Phone Fit keeps a readable stage window with lateral panning, rather
  // than shrinking all ten stages into a single illegible phone-width image.
  setView(fitBox(mobileStageBox()));
 }else setView(fitBox(visibleContentBox(),{focus}));
}
function zoom(factor){
 if(mode==="linear"){
  linearStep=Math.max(105,Math.min(205,linearStep/factor));
  linear.style.setProperty("--stop-step",linearStep+"px");
  return;
 }
 const cx=view.x+view.w/2,cy=view.y+view.h/2;
 const minWidth=baseline.w*.28,maxWidth=baseline.w*1.1;
 const w=Math.max(minWidth,Math.min(maxWidth,view.w*factor));
 const h=w/mapAspect();
 setView({x:cx-w/2,y:cy-h/2,w,h});
}
function updateLabels(){
 if(mode!=="schematic")return;
 const state=selection();
 const pixelFont=23*svg.clientWidth/Math.max(1,view.w);
 const blocked=[...svg.querySelectorAll("#stage-headings text,#research-layer-guides text")]
  .filter(t=>getComputedStyle(t).display!=="none").map(t=>t.getBoundingClientRect());
 const placed=[];
 const overlaps=(a,b)=>a.left<b.right+3&&a.right+3>b.left&&
                         a.top<b.bottom+3&&a.bottom+3>b.top;
 const candidates=labels.map(t=>{
  const m=data.moments[t.dataset.stationId];
  return {t,m,tier:anchors.has(m?.id)?0:m?.decision?1:m?.key?2:3};
 }).sort((a,b)=>a.tier-b.tier);
 const bounds=svg.getBoundingClientRect();
 for(const {t,m,tier} of candidates){
  let eligible=tier===0||(tier===1&&pixelFont>=10.5)||
      (tier===2&&pixelFont>=13)||(pixelFont>=19);
  if(expandedLabels)eligible||=tier<=2&&pixelFont>=9.5;
  eligible&&=state.ids.has(t.dataset.stationId);
  if(!eligible){t.style.opacity="0";t.style.pointerEvents="none";continue}
  t.style.opacity="1";
  const r=t.getBoundingClientRect();
  if(!r.width||!r.height||r.left<bounds.left+5||r.right>bounds.right-5||
     r.top<bounds.top+5||r.bottom>bounds.bottom-5||
     blocked.some(q=>overlaps(r,q))||placed.some(q=>overlaps(r,q))){
   t.style.opacity="0";t.style.pointerEvents="none";continue;
  }
  t.style.pointerEvents="auto";
  placed.push(r);
 }
}
function showInspector(mid){
 const m=data.moments[mid];if(!m)return;
 selectedId=mid;ins.hidden=false;
 for(const c of circles)c.classList.toggle("selected-station",c.dataset.stationId===mid);
 insBody.innerHTML='<h2>'+escapeHtml(m.label)+'</h2>'+
 '<div class="field"><small>Journey stage</small><b>'+escapeHtml(m.stage)+'</b></div>'+
 '<div class="field"><small>Authored research layer</small><b>'+escapeHtml(m.researchLayer)+'</b></div>'+
 '<div class="field"><small>Evidence class</small><b>'+escapeHtml(m.evidence)+
 (m.evidenceRefPresent?' · source reference present':' · no linked source in public fixture')+'</b></div>'+
 '<div class="field"><small>Authored source relationships</small><p>'+m.links.map(e=>
 escapeHtml(e.id+' · '+e.kind+' · '+e.from+' → '+e.to)).join(', ')+'</p></div>';
 // Inspecting a station NEVER changes the camera. Click or Enter has identical behavior.
}
function createLinear(){
