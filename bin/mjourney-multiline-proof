#!/usr/bin/env python3
"""Source-backed cartographic line proof: 18 moments, two named candidate routes.
This is NOT an edit to the canonical 67/87 research graph or a licensed
customer journey traversal. Research IDs and line/edge provenance are audited.
The diagram is an isolated proof of line occupancy and LOOM geometry fidelity.
"""
from __future__ import annotations

